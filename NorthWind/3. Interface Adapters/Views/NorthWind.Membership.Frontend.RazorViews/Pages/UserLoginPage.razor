@using NorthWind.Membership.Frontend.RazorViews.ViewModels.UserLogin
@page "/user/login"
@inject UserLoginViewModel ViewModel
@inject NavigationManager NavigationManager

<ErrorBoundary @ref="ErrorBoundaryRef">
    <ChildContent>
        <UserLoginComponent ViewModel="ViewModel" />
    </ChildContent>
    <ErrorContent Context="exception">
        <ExceptionDisplay Exception="exception" />
        <button class="btn btn-danger" @onclick="Recover">@CommonMessages.OK</button>
    </ErrorContent>
</ErrorBoundary>

@code {
    private const string RouteTemplate = "/user/login";
    private ErrorBoundary? ErrorBoundaryRef { get; set; }

    protected override void OnInitialized()
    {
        ViewModel.OnLogin += OnLogin;
    }

    private void OnLogin()
    {
        if (NavigationManager.Uri.EndsWith(RouteTemplate, StringComparison.OrdinalIgnoreCase))
        {
            NavigationManager.NavigateTo("");
        }
        else
        {
            NavigationManager.NavigateTo(NavigationManager.Uri);
        }
    }

    private void Recover() => ErrorBoundaryRef?.Recover();
}
